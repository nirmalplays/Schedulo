# Database.
# Supabase: Project → Connect → "Transaction pooler" (port 6543), for the app.
# Fully local instead: run `npm run db` in another terminal and use
#   postgres://postgres:postgres@127.0.0.1:54329/calclone
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Connections per server process (keep small with Supabase's pooler limits)
DATABASE_POOL_MAX=5

# Public base URL used in emails and auth redirects
APP_URL=http://localhost:3000

# Supabase Auth (Project Settings → API Keys). Sign-in: Google + email magic link.
# Supabase → Authentication → URL Configuration → Redirect URLs must include <APP_URL>/auth/callback
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Google OAuth client: the same one configured in Supabase → Authentication → Providers → Google.
# Needed server-side to refresh calendar access and for "Connect Google Calendar".
# Authorized redirect URIs on the client:
#   https://<project-ref>.supabase.co/auth/v1/callback   (Supabase sign-in)
#   <APP_URL>/api/google/callback                       (Connect Google Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts OAuth tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored calendar connections unreadable (hosts must reconnect).
TOKEN_ENCRYPTION_KEY=

# Booking emails via Resend (optional in dev: they're logged to the console).
# Sign-in emails are sent by Supabase Auth.
RESEND_API_KEY=
EMAIL_FROM="Bookings <bookings@example.com>"
